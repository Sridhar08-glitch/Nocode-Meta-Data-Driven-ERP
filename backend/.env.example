# NexusERP backend environment. Copy to `.env` and fill in. Every key below is read by
# config/settings/base.py (or production.py). Keys are grouped by concern.

# ── Django ─────────────────────────────────────────────────────────────────
# REQUIRED in production — generate a 50+ char random string. The dev default is insecure
# and production.py refuses to boot if this is left at the default.
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed by CORS (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_dev

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Secrets / encryption ─────────────────────────────────────────────────────
# Fernet-derived key for at-rest secrets (MFA/TOTP, etc.). REQUIRED in production —
# production.py refuses to boot at the insecure default. Generate a long random string.
ENCRYPTION_KEY=change-me-generate-a-long-random-string

# ── JWT RS256 Keys (paths to PEM files) ─────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# ── OAuth: Google ─────────────────────────────────────────────────────────────
# Preferred keys are GOOGLE_OAUTH_* ; the legacy GOOGLE_CLIENT_* are still read as a fallback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── OAuth: Microsoft (Azure AD) ───────────────────────────────────────────────
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# ── WebAuthn / Passkeys ────────────────────────────────────────────────────────
# RP_ID = registrable domain (e.g. example.com); ORIGIN must match the site origin exactly.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NexusERP
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Dev defaults to a console/MailHog setup. production.py switches to the SMTP backend and
# authenticates with EMAIL_HOST_USER / EMAIL_HOST_PASSWORD. Use TLS (587) OR SSL (465), not both.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@nexuserp.local

# ── Frontend origin ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Documents / Storage ────────────────────────────────────────────────────────
# Local filesystem by default. Set DOCUMENTS_STORAGE_BACKEND=s3 to use S3 (boto3 picks up
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the standard env automatically).
MEDIA_ROOT=./media
DOCUMENTS_STORAGE_BACKEND=local
DOCUMENTS_S3_BUCKET=
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── PDF rendering ──────────────────────────────────────────────────────────────
# "reportlab" (pure-Python, default, works everywhere) or "weasyprint" (HTML/CSS; needs GTK).
NEXUS_PDF_BACKEND=reportlab

# ── Auth hardening ─────────────────────────────────────────────────────────────
LOGIN_LOCKOUT_ENABLED=True

# ── Observability (Phase P1.6) ───────────────────────────────────────────────
# Sentry is OPTIONAL: leave SENTRY_DSN empty to disable error/perf reporting entirely
# (the default for dev/CI/tests — no network calls). Requires `pip install sentry-sdk`.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
# Liveness/readiness probes are unauthenticated at /healthz/ and /readyz/ (no env needed).
# Every response carries an X-Request-ID (honours an inbound one from your proxy).
